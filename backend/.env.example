# Production environment variables for Django app
# Copy this to .env on the server and fill in real values

# Django
DJANGO_SECRET_KEY=change-me-to-a-very-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_CORS_ALLOW_ALL=False

# Database (PostgreSQL)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Neon/Vercel preferred connection string. If set, it takes precedence over DB_*.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SEED_DEMO_PASSWORD=replace-with-a-test-password-at-least-8-chars

# Zarinpal Payment (optional)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=False
ZARINPAL_CALLBACK_URL=https://yourdomain.com/api/payments/callback/

