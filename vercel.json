{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "runtime": "python3.12" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/front/index.html" },
    { "src": "/(.*)", "dest": "/front/$1" }
  ],
  "trailingSlash": false
}
