{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "front"
    },
    "backend": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "config/wsgi.py",
      "buildCommand": "python manage.py migrate --noinput && python manage.py seed_demo_data --password \"$SEED_DEMO_PASSWORD\""
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
