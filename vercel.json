{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": { "root": "front" },
    "backend": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "config/wsgi.py",
      "buildCommand": "python manage.py migrate --noinput && if [ -n \"$SEED_DEMO_PASSWORD\" ] || [ -n \"$SEED_ADMIN_PASSWORD\" ]; then python scripts/create_users.py; else echo 'Seed password is not configured; skipping demo-user seed.'; fi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ],
  "headers": [
    {
      "source": "/(.*\\.(html|js|css))",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}
