{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": { "root": "front" },
    "backend": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "config/wsgi.py",
      "buildCommand": "python manage.py migrate --noinput"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
